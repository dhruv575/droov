# Server-side only — no VITE_ prefix, so Vite never inlines these into the
# client bundle. Copy to .env for local dev; set the same names as secrets on
# your host (Vercel: Project Settings > Environment Variables;
# Cloudflare Pages: wrangler pages secret put OPENROUTER_API_KEY).

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-5.6-luna
SITE_URL=https://droov.gupta
